APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Local PostgreSQL. For Neon use sslmode=verify-full (see docs/operations.md).
DATABASE_URL=postgres://app:local-development-only@localhost:5432/enterprise?sslmode=disable
# Use the DIRECT (non-pooler) endpoint for migrations on Neon.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
# Generate with: openssl rand -hex 32. This example intentionally fails validation.
JWT_SECRET=replace-with-a-random-secret
JWT_ISSUER=enterprise-rust-backend
JWT_AUDIENCE=enterprise-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_CONCURRENCY=4
# Empty means no cross-origin browser clients; use comma-separated exact origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=15
REQUEST_BODY_LIMIT_BYTES=16384
AUTH_REQUESTS_PER_MINUTE=20
RUST_LOG=info,sqlx=warn
